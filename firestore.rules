rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin (by reading their user document)
    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Settings collection - readable by all, writable by admins only
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Products collection - readable by all, writable by admins
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Categories collection - readable by all, writable by admins
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Orders collection - users can read their own orders, admins can read all
    match /orders/{orderId} {
      allow read: if isAuthenticated() && 
                   (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Users collection - users can read/write their own profile, admins can access all
    match /users/{userId} {
      allow read: if isAuthenticated() && 
                   (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && 
                    (request.auth.uid == userId || isAdmin());
    }
    
    // Cart collection - private to each user
    match /carts/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // FAQ collection - readable by all, writable by admins
    match /faqs/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Help messages collection - users can read/write their own, admins can access all
    match /helpMessages/{msgId} {
      allow read: if isAuthenticated() && 
                   (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
