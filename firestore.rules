rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin (reads user's Firestore document)
    function isAdmin() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Settings collection - readable by all, writable by admins only
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Products collection - public read, admin-only writes
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // Categories collection - readable by all, writable by admins
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Orders collection
    // - Authenticated users may CREATE orders for themselves (status should start as 'pending')
    // - Users may READ only their own orders
    // - Client-side UPDATES are allowed only when NOT changing the 'status' field; admins may update freely via server
    match /orders/{orderId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'pending';

      allow read: if isAuthenticated() && request.auth.uid == resource.data.userId;

      // Allow update/delete only for admins, or for the order owner when they do not change the status field
      allow update, delete: if isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.userId && request.resource.data.status == resource.data.status);
    }
    
    // Users collection - users may read/write only their own document
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Cart collection - private to each user
    match /carts/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // FAQ collection - readable by all, writable by admins
    match /faqs/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Help messages collection - users can read/write their own, admins can access all
    match /helpMessages/{msgId} {
      allow read: if isAuthenticated() && 
                   (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
